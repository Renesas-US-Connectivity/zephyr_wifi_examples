/delete-node/ &qspi;
/delete-node/ &uart1;

/* Disable NFC so P0.09 and P0.10 can be used as GPIOs */
&nfct {
    status = "disabled";
};

/ {
    chosen {
        /delete-property/ zephyr,wifi;
	};

    aliases {
        wakeup-gpio = &gpio_wakeup;
    };

    gpio_wakeup {
        compatible = "gpio-leds";
        gpio_wakeup: wakeup_gpio {
            gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "Wakeup GPIO P1.7";
        };
    };
};

/delete-node/ &button2;
/delete-node/ &button3;

/* Remove aliases to deleted buttons */
/ {
    aliases {
        /delete-property/ sw2;
        /delete-property/ sw3;
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>;
       
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>;
           
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    cs-gpios = <&gpio1 6 (GPIO_ACTIVE_LOW)>;
 
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
 
    ra6w1_erpc_wifi: ra6w1_erpc_wifi@0 {
        compatible = "renesas,erpc-wifi-spi";
        reg = <0>;
        label = "RA6W1";
        spi-max-frequency = <200000>;
        boot-duration-ms = <2000>;
        int-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        reset-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};
