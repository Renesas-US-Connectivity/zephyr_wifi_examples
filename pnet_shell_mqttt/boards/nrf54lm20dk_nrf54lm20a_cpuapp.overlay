/ {
    chosen {
        /delete-property/ zephyr,wifi;
	};

    aliases {
        wakeup-gpio = &gpio_wakeup;
    };

    gpio_wakeup {
        compatible = "gpio-leds";
        gpio_wakeup: wakeup_gpio {
           gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "Wakeup GPIO P0.03";
        };
    };
};

&pinctrl {
    spi22_default: spi22_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>;
       
        };
    };
    spi22_sleep: spi22_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>;
           
            low-power-enable;
        };
    };
};

&spi22 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    cs-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW)>;
 
    pinctrl-0 = <&spi22_default>;
    pinctrl-1 = <&spi22_sleep>;
    pinctrl-names = "default", "sleep";
 
    ra6w1_erpc_wifi: ra6w1_erpc_wifi@0 {
        compatible = "renesas,erpc-wifi-spi";
        reg = <0>;
        label = "RA6W1";
        spi-max-frequency = <200000>;
        boot-duration-ms = <2000>;
        int-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        reset-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};
